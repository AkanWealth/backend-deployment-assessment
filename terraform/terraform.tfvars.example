# Copy to terraform.tfvars and edit. terraform.tfvars is git-ignored.

aws_region = "us-east-1"

bastion_instance_type = "t3.micro"
backend_instance_type = "t3.micro"
mongodb_instance_type = "t3.micro"

# Your public IP as a /32. Find it with: curl -s https://checkip.amazonaws.com
# Remove this line to auto-detect it.
my_ip = "203.0.113.10/32"

public_key_path = "~/.ssh/id_ed25519.pub"
