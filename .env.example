# Copy to .env and fill in real values. .env is git-ignored.

# MongoDB root user (created on first start of the mongodb container)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-to-a-strong-password

# Database name used by the app
DB_NAME=much_todo_db

# Long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET_KEY=change-me

JWT_EXPIRATION_HOURS=72
LOG_LEVEL=INFO
LOG_FORMAT=json

# Optional: point the backend at the MongoDB EC2 instance instead of the
# mongodb container. Leave unset to use the container.
# MONGO_URI=mongodb://admin:<password>@<mongodb-private-ip>:27017/?authSource=admin&replicaSet=rs0
